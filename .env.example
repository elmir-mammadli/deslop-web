# Signs page results so saved reports cannot be forged. Any long random string.
DESLOP_SECRET=

# Vercel Blob store for shareable report links. Without it, links are saved to .data/ locally
# and the share button is hidden in production.
BLOB_READ_WRITE_TOKEN=

# Optional: Cloudflare Turnstile on the audit form.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Local development only: path to a Chrome or Chromium binary.
CHROME_PATH=

# Pages audited per site (default 12).
MAX_PAGES=
